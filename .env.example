# 审查 Agent 环境变量示例
# 用法：复制为 .env 后填写，或直接在 shell 里 export。
# 注意 .env 已在 .gitignore 中，切勿把真实密钥提交到仓库。

# ---- 审查模式 ----
# static：确定性规则引擎（默认，快、可复现，适合放进循环反复跑）
# llm：codeguard 的完整 Agent 闭环（慢、要 Key，但能发现语义级问题）
REVIEW_MODE=static

# ---- 质量门禁 ----
# 达到这些级别的问题视为"不合格"，会阻断流水线。逗号分隔。
# 早期项目可以放宽到 critical，发版前收紧到 high,medium
REVIEW_BLOCKING=critical,high

# ---- 审查范围 ----
# 待审查文件的 glob，逗号分隔
REVIEW_PATTERNS=*.py
# 静态审查时按文件并行的数量
REVIEW_PARALLEL=4
# 单次最多处理多少文件，防止误指到超大目录
REVIEW_MAX_FILES=200

# ---- codeguard 定位（一般不需要填）----
# 四个仓库放在同一目录时会自动发现 codeguard；也可以用显式路径覆盖
# REVIEW_CODEGUARD_PATH=../codeguard

# ---- LLM（mode=llm 时必填，直接透传给 codeguard）----
# 沿用 Homework 1 的变量名，便于两个项目共用一份配置
CODEGUARD_API_KEY=sk-替换成你自己的key
# 或者用本 Agent 自己的前缀：
# REVIEW_API_KEY=sk-xxxx
REVIEW_BASE_URL=https://api.deepseek.com
REVIEW_MODEL=deepseek-chat
REVIEW_TEMPERATURE=0.2
REVIEW_MAX_ITERATIONS=10
